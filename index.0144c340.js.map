"use strict";
document.addEventListener("DOMContentLoaded", function() {
    var showNotification = // Notification helper
    function showNotification(type, message) {
        var note = document.createElement("div");
        note.className = "notification ".concat(type);
        note.dataset.qa = "notification";
        note.textContent = message;
        document.body.appendChild(note);
        setTimeout(function() {
            return note.remove();
        }, 3000);
    };
    var table = document.querySelector(".employees-table");
    var tbody = table.querySelector("tbody");
    var sortDirection = {};
    // Sorting logic
    table.querySelectorAll("th").forEach(function(header, index) {
        header.addEventListener("click", function() {
            sortDirection[index] = sortDirection[index] === "asc" ? "desc" : "asc";
            var rows = Array.from(tbody.querySelectorAll("tr"));
            rows.sort(function(a, b) {
                var cellA = a.cells[index].textContent.trim();
                var cellB = b.cells[index].textContent.trim();
                return sortDirection[index] === "asc" ? cellA.localeCompare(cellB, undefined, {
                    numeric: true
                }) : cellB.localeCompare(cellA, undefined, {
                    numeric: true
                });
            });
            rows.forEach(function(row) {
                return tbody.appendChild(row);
            });
        });
    });
    // Row selection on click
    tbody.addEventListener("click", function(e) {
        tbody.querySelectorAll("tr").forEach(function(row) {
            return row.classList.remove("active");
        });
        var clickedRow = e.target.closest("tr");
        if (clickedRow) clickedRow.classList.add("active");
    });
    // Inline editing on double-click
    tbody.addEventListener("dblclick", function(e) {
        var cell = e.target;
        if (!cell.matches("td") || cell.querySelector("input")) return;
        var input = document.createElement("input");
        input.className = "cell-input";
        input.value = cell.textContent.trim();
        input.dataset.originalValue = input.value;
        cell.textContent = "";
        cell.appendChild(input);
        input.focus();
        var save = function() {
            cell.textContent = input.value.trim() || input.dataset.originalValue;
        };
        input.addEventListener("blur", save);
        input.addEventListener("keypress", function(ev) {
            return ev.key === "Enter" && save();
        });
    });
    // Add employee form
    var form = document.createElement("form");
    form.className = "new-employee-form";
    form.innerHTML = '\n    <label>Name: <input name="name" required data-qa="name" /></label>\n    <label>Position: <input name="position" required data-qa="position" /></label>\n    <label>Office:\n      <select name="office" data-qa="office">\n        <option>Tokyo</option><option>Singapore</option><option>London</option>\n        <option>New York</option><option>Edinburgh</option><option>San Francisco</option>\n      </select>\n    </label>\n    <label>Age: <input name="age" type="number" required data-qa="age" /></label>\n    <label>Salary: <input name="salary" type="number" required data-qa="salary" /></label>\n    <button type="submit">Save to table</button>\n  ';
    document.body.appendChild(form);
    form.addEventListener("submit", function(currentevent) {
        currentevent.preventDefault();
        var employeeName = form.name.value.trim();
        var position = form.position.value.trim();
        var office = form.office.value;
        var employeeAge = parseInt(form.age.value, 10);
        var employeeSalary = parseFloat(form.salary.value);
        if (employeeName.length < 4) return showNotification("error", "Name must be at least 4 characters");
        if (employeeAge < 18 || employeeAge > 90) return showNotification("error", "Age must be between 18 and 90");
        var row = document.createElement("tr");
        row.innerHTML = "\n      <td>".concat(employeeName, "</td>\n      <td>").concat(position.value.trim(), "</td>\n      <td>").concat(office.value, "</td>\n      <td>").concat(employeeAge, "</td>\n      <td>").concat(employeeSalary.toFixed(2), "</td>\n    ");
        tbody.appendChild(row);
        showNotification("success", "Employee added successfully!");
        form.reset();
    });
});

